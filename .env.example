# Postgres connection string (Neon / Vercel Postgres)
POSTGRES_URL=postgresql://127.0.0.1:5432/stall-eichenbruch

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash. Optional on Vercel.
SITE_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Vercel Blob for media uploads (optional locally – without it files go to public/media)
BLOB_READ_WRITE_TOKEN=

# SMTP for form notifications and password resets (optional locally – without SMTP_HOST mails are logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=website@stall-eichenbruch.de
